{
  "name": "sigame-local",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted LAN Jeopardy-style game inspired by SIGame. Supports original .siq packs and Steam Workshop downloads.",
  "type": "module",
  "main": "server/index.ts",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "inspect-pack": "tsx scripts/inspect-pack.ts",
    "make-sample": "tsx scripts/make-sample-pack.ts",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "adm-zip": "^0.5.16",
    "express": "^4.21.1",
    "fast-xml-parser": "^4.5.0",
    "ffmpeg-static": "^5.3.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "steamworks.js": "^0.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
